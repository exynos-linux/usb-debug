# SPDX-License-Identifier: GPL-2.0-only
#
# usb-debug console: the bring-up init (nolibc) and the standalone console.
#
#   make console                     the console for development images
#                                    (CONSOLE_STDIO, libc; CC, CFLAGS, LDFLAGS)
#   make init NOLIBC=<linux>/tools/include/nolibc [KHDR=<uapi headers>]
#        [CROSS_COMPILE=aarch64-linux-gnu-] [BOARDS=gtactive3wifi]
#                                    the bring-up init (static PID 1)
#   make uinput-type NOLIBC=... [KHDR=...] [CROSS_COMPILE=...]
#                                    the virtual keyboard of "usb-debug login"
#
# BOARDS: the board files (boards/<name>.c) to build in, default all of
# them. EXTRA_BOARDS: board files from elsewhere (a device repository); each
# defines "const struct board board_<file name>". O: output directory.
# EXTRA_CFLAGS: added to every build (the tests use it).

SRC := $(patsubst %/,%,$(dir $(abspath $(lastword $(MAKEFILE_LIST)))))
VERSION := $(shell cat $(SRC)/../VERSION)
O ?= .
CROSS_COMPILE ?=
EXTRA_CFLAGS ?=
CC := $(if $(filter default,$(origin CC)),$(CROSS_COMPILE)gcc,$(CC))
STRIP ?= $(CROSS_COMPILE)strip
NOLIBC ?=
KHDR ?=

BOARDS ?= $(sort $(basename $(notdir $(wildcard $(SRC)/boards/*.c))))
EXTRA_BOARDS ?=
BOARD_SRCS := $(foreach b,$(BOARDS),$(SRC)/boards/$(b).c) $(abspath $(EXTRA_BOARDS))
BOARD_NAMES := $(BOARDS) $(basename $(notdir $(EXTRA_BOARDS)))
SOC_SRCS := $(sort $(wildcard $(SRC)/soc/*.c))
SOC_NAMES := $(basename $(notdir $(SOC_SRCS)))
SRCS := $(SRC)/core.c $(O)/boards.c $(SOC_SRCS) $(BOARD_SRCS)
DEPS := $(SRCS) $(SRC)/usbdbg.h $(SRC)/compat-libc.h $(SRC)/../VERSION

WARN := -Wall -Wno-unused-function -Wno-unused-variable
DEFS := -DUSBDBG_VERSION='"$(VERSION)"'
NOLIBC_FLAGS = -Os -static -nostdlib -fno-stack-protector -fno-asynchronous-unwind-tables \
	-I$(SRC)/stub -I$(NOLIBC) $(if $(KHDR),-I$(KHDR)) -include $(NOLIBC)/nolibc.h

.PHONY: all console init uinput-type clean FORCE

all: console

# the table of compiled-in entries, rewritten only when the list changes
$(O)/boards.c: FORCE
	@mkdir -p $(O)
	@{ echo '/* generated by console/Makefile */'; \
	  echo '#include "$(SRC)/usbdbg.h"'; \
	  for s in $(SOC_NAMES); do echo "extern const struct soc soc_$$s;"; done; \
	  for b in $(BOARD_NAMES); do echo "extern const struct board board_$$b;"; done; \
	  printf 'const struct soc *const socs[] = {'; \
	  for s in $(SOC_NAMES); do printf ' &soc_%s,' $$s; done; echo ' 0 };'; \
	  printf 'const struct board *const boards[] = {'; \
	  for b in $(BOARD_NAMES); do printf ' &board_%s,' $$b; done; echo ' 0 };'; \
	} > $@.tmp; cmp -s $@.tmp $@ && rm -f $@.tmp || mv $@.tmp $@

console: $(O)/usb-debug-console
$(O)/usb-debug-console: $(DEPS)
	$(CC) $(CFLAGS) -O2 $(WARN) $(DEFS) $(EXTRA_CFLAGS) -DCONSOLE_STDIO -include $(SRC)/compat-libc.h \
		-o $@ $(SRCS) $(LDFLAGS)

init: $(O)/init
$(O)/init: $(DEPS)
	@test -n "$(NOLIBC)" || { echo "make init: set NOLIBC=<linux>/tools/include/nolibc" >&2; exit 1; }
	$(CC) $(NOLIBC_FLAGS) $(WARN) $(DEFS) $(EXTRA_CFLAGS) -o $@ $(SRCS) -lgcc

uinput-type: $(O)/uinput-type
$(O)/uinput-type: $(SRC)/../tools/uinput-type/uinput-type.c
	@test -n "$(NOLIBC)" || { echo "make uinput-type: set NOLIBC=<linux>/tools/include/nolibc" >&2; exit 1; }
	$(CC) $(NOLIBC_FLAGS) -Wall -o $@ $< -lgcc
	$(STRIP) $@

clean:
	rm -f $(O)/boards.c $(O)/usb-debug-console $(O)/init $(O)/uinput-type
